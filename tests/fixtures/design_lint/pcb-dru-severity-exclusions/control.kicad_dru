(version 1)
(rule "SyntheticErrorWidth"
  (condition "A.NetName == 'SYNTHETIC_NET'")
  (severity error)
  (constraint track_width (min 0.25mm)))
(rule "SyntheticWarningWidth"
  (condition "A.NetName == 'SYNTHETIC_NET'")
  (severity warning)
  (constraint track_width (min 0.25mm)))
(rule "SyntheticIgnoredWidth"
  (condition "A.NetName == 'SYNTHETIC_NET'")
  (severity ignore)
  (constraint track_width (min 0.25mm)))
