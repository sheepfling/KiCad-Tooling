(version 1)
(rule "SYNTHETIC_RULE_A"
  (condition "A.Type == 'Track'")
  (severity error)
  (constraint track_width (min 0.2mm)))
(rule "SYNTHETIC_RULE_B"
  (condition "A.Type == 'Via'")
  (severity warning)
  (constraint clearance (min 0.3mm)))
(rule "synthetic_rule_a"
  (condition "A.Type == 'Pad'")
  (severity error)
  (constraint physical_clearance (min 0.4mm)))
# A comment mentioning the repeated source name is not a rule declaration.
# SYNTHETIC_DUPLICATE_NAME
