# Exact pad-to-filled-zone clearance requests for the read-only native probe.

def read_touch_pad_clearance_requests(
    path: Path | None,
) -> tuple[list[TouchPadClearanceRequest], str | None]:
    if path is None:
        return [], None
    raw_bytes = path.read_bytes()
    raw_value: object = json.loads(raw_bytes)
    if not isinstance(raw_value, dict) or set(raw_value) != {"schema_version", "requests"}:
        raise ValueError("Touch-pad probe request file has an invalid object shape")
    raw = cast(RawTouchClearanceRequestEnvelope, raw_value)
    if raw["schema_version"] != "1" or not isinstance(raw["requests"], list):
        raise ValueError("Touch-pad probe request file has an unsupported schema")
    required = {
        "id",
        "pad",
        "expected_pad_net",
        "reference_net",
        "layer",
        "minimum_clearance_nm",
    }
    raw_requests = cast(list[object], raw["requests"])
    requests: list[TouchPadClearanceRequest] = []
    seen_ids: set[str] = set()
    for row_value in raw_requests:
        if not isinstance(row_value, dict) or set(row_value) != required:
            raise ValueError("Touch-pad probe request has an invalid shape")
        row = cast(RawTouchClearanceRequest, row_value)
        string_fields = {
            key: row[key]
            for key in required - {"minimum_clearance_nm"}
        }
        if not all(isinstance(value, str) and value for value in string_fields.values()):
            raise ValueError("Touch-pad probe request has invalid values")
        minimum_clearance = row["minimum_clearance_nm"]
        if type(minimum_clearance) is not int or minimum_clearance <= 0:
            raise ValueError("Touch-pad probe request has invalid values")
        request: TouchPadClearanceRequest = {
            "id": cast(str, string_fields["id"]),
            "pad": cast(str, string_fields["pad"]),
            "expected_pad_net": cast(str, string_fields["expected_pad_net"]),
            "reference_net": cast(str, string_fields["reference_net"]),
            "layer": cast(str, string_fields["layer"]),
            "minimum_clearance_nm": minimum_clearance,
        }
        key = request["id"].casefold()
        if key in seen_ids:
            raise ValueError("Touch-pad probe request IDs must be unique")
        seen_ids.add(key)
        requests.append(request)
    return requests, hashlib.sha256(raw_bytes).hexdigest()


def touch_pad_clearance_observations(
    requests: list[TouchPadClearanceRequest],
    pad_geometry: list[tuple[str, bool, NativePad]],
    zone_objects: dict[tuple[str, str], NativeZone],
    filled_polygons: dict[tuple[str, str], NativePolygonSet],
    board: NativeBoard,
) -> list[TouchPadClearanceObservation]:
    """Measure exact KiCad pad-shape clearance to matching filled copper zones."""
    layer_ids = {
        board.GetLayerName(layer).casefold(): layer
        for layer in board.GetEnabledLayers().CuStack()
    }
    observations: list[TouchPadClearanceObservation] = []
    for request in requests:
        requested_pad = request["pad"]
        matches = [
            pad
            for reference, _dnp, pad in pad_geometry
            if reference.casefold() == requested_pad.casefold()
        ]
        observation: TouchPadClearanceObservation = {
            "requirement_id": request["id"],
            "pad": requested_pad,
            "expected_pad_net": request["expected_pad_net"],
            "observed_pad_net": None,
            "reference_net": request["reference_net"],
            "layer": request["layer"],
            "matching_zone_count": 0,
            "closest_zone_uuid": None,
            "distance_nm": None,
            "status": "PAD_MISSING",
        }
        if not matches:
            observations.append(observation)
            continue
        if len(matches) != 1:
            observation["status"] = "PAD_AMBIGUOUS"
            observations.append(observation)
            continue
        pad = matches[0]
        pad_net = pad.GetNetname() or None
        observation["observed_pad_net"] = pad_net
        layer_id = layer_ids.get(request["layer"].casefold())
        if layer_id is None:
            observation["status"] = "UNSUPPORTED_LAYER"
            observations.append(observation)
            continue
        if not pad.GetLayerSet().Contains(layer_id):
            observation["status"] = "PAD_LAYER_ABSENT"
            observations.append(observation)
            continue
        pad_shape = pad.GetEffectiveShape(layer_id)
        if pad_shape is None or pad_shape.IsNull():
            raise ValueError(f"KiCad returned no effective pad shape for {requested_pad}")

        matching_zones: list[tuple[str, NativeZone, NativePolygonSet]] = [
            (uuid, zone, filled_polygons[identity])
            for identity, zone in zone_objects.items()
            if (uuid := zone.m_Uuid.AsString())
            and board.GetLayerName(zone.GetLayer()).casefold() == request["layer"].casefold()
            and (zone.GetNetname() or "").casefold() == request["reference_net"].casefold()
        ]
        observation["matching_zone_count"] = len(matching_zones)
        if not matching_zones:
            observation["status"] = "NO_REFERENCE_ZONE"
            observations.append(observation)
            continue
        measured: list[tuple[int, str, str]] = []
        for uuid, _zone, filled in matching_zones:
            if filled is None or filled.OutlineCount() == 0:
                continue
            if pad_shape.Collide(filled, 0):
                distance_nm = 0
            else:
                distance_nm = int(pad_shape.GetClearance(filled))
                if distance_nm < 0:
                    raise ValueError(
                        f"KiCad returned a negative pad-to-zone clearance for {requested_pad}"
                    )
            measured.append((distance_nm, uuid.casefold(), uuid))
        if not measured:
            observation["status"] = "NO_FILLED_REFERENCE_COPPER"
            observations.append(observation)
            continue
        distance_nm, _uuid_key, closest_zone_uuid = min(measured)
        observation["closest_zone_uuid"] = closest_zone_uuid
        observation["distance_nm"] = distance_nm
        observation["status"] = "MEASURED"
        observations.append(observation)
    return observations
