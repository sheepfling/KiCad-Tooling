"""Isolated KiCad 10 pcbnew entry point; imported only inside the pinned image."""

from __future__ import annotations

import hashlib
import json
import sys
from math import floor
from pathlib import Path
from typing import Any, cast

import pcbnew as _pcbnew  # type: ignore[import-not-found]

native_pcbnew: Any = cast(Any, _pcbnew)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pad_reference(pad: Any) -> str:
    footprint = pad.GetParentFootprint()
    number = str(pad.GetNumber()).strip()
    if not number:
        return ""
    return f"{footprint.GetReference()}.{number}"


def via_observation(via: Any, board: Any) -> dict[str, Any]:
    """Return a geometry-derived stable identity for one KiCad via."""
    top_layer = via.TopLayer()
    bottom_layer = via.BottomLayer()
    start_layer = board.GetLayerName(top_layer)
    end_layer = board.GetLayerName(bottom_layer)
    position = via.GetPosition()
    if via.IsMicroVia():
        kind = "micro"
    elif via.IsBlindVia():
        kind = "blind"
    elif via.IsBuriedVia():
        kind = "buried"
    else:
        kind = "through"
    row = {
        "net": via.GetNetname() or None,
        "x_nm": int(position.x),
        "y_nm": int(position.y),
        "start_layer": start_layer,
        "end_layer": end_layer,
        "diameter_nm": int(via.GetWidth(top_layer)),
        "drill_nm": int(via.GetDrillValue()),
        "kind": kind,
    }
    canonical = json.dumps(row, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    row["id"] = hashlib.sha256(canonical.encode("ascii")).hexdigest()
    return row


def access_probe_observations(
    requests: list[dict[str, str]], pad_geometry: list[tuple[str, bool, Any]]
) -> list[dict[str, Any]]:
    """Measure each requested pad center to the nearest exposed foreign-net pad."""
    observations: list[dict[str, Any]] = []
    layer_ids = {
        "front": (native_pcbnew.F_Cu, native_pcbnew.F_Mask),
        "back": (native_pcbnew.B_Cu, native_pcbnew.B_Mask),
    }

    def exposed(pad: Any, side: str) -> bool:
        copper_layer, mask_layer = layer_ids[side]
        layers = pad.GetLayerSet()
        return bool(layers.Contains(copper_layer) and layers.Contains(mask_layer))

    def aperture_geometry(pad: Any, mask_layer: int) -> tuple[str, int | None]:
        """Measure circular, undrilled pad-mask apertures without approximating other shapes."""
        if pad.GetShape(mask_layer) != native_pcbnew.PAD_SHAPE_CIRCLE:
            return "unsupported", None
        drill = pad.GetDrillSize()
        if int(drill.x) > 0 or int(drill.y) > 0:
            return "unsupported", None
        copper_size = pad.GetSize(mask_layer)
        if int(copper_size.x) != int(copper_size.y):
            return "unsupported", None
        mask_expansion_nm = int(pad.GetSolderMaskExpansion(mask_layer))
        diameter_nm = int(copper_size.x) + 2 * mask_expansion_nm
        if diameter_nm <= 0:
            return "unsupported", None
        return "circle", diameter_nm

    for request in requests:
        endpoint = request["endpoint"]
        side = request["side"]
        copper_layer, _mask_layer = layer_ids[side]
        endpoint_pads = [
            (dnp, pad)
            for reference, dnp, pad in pad_geometry
            if reference.casefold() == endpoint.casefold()
        ]
        if not endpoint_pads:
            raise ValueError(f"Requested probe endpoint {endpoint} is absent from the PCB")
        target_nets = {pad.GetNetname() or None for _dnp, pad in endpoint_pads}
        if len(target_nets) != 1:
            raise ValueError(f"Requested probe endpoint {endpoint} has conflicting pad nets")
        target_net = next(iter(target_nets))
        targets = [pad for dnp, pad in endpoint_pads if not dnp and exposed(pad, side)]
        if len(targets) > 1:
            raise ValueError(
                f"Requested probe endpoint {endpoint} has multiple exposed {side}-side pads"
            )
        if not targets:
            observations.append(
                {
                    "endpoint": endpoint,
                    "side": side,
                    "target_net": target_net,
                    "target_exposed": False,
                    "obstacle": None,
                    "obstacle_net": None,
                    "distance_nm": None,
                    "target_aperture_shape": None,
                    "target_aperture_diameter_nm": None,
                }
            )
            continue
        target = targets[0]
        aperture_shape, aperture_diameter_nm = aperture_geometry(target, layer_ids[side][1])
        nearest: tuple[int, str, str, str | None] | None = None
        position = target.GetPosition()
        for reference, dnp, obstacle in pad_geometry:
            if reference.casefold() == endpoint.casefold() or dnp or not exposed(obstacle, side):
                continue
            obstacle_net = obstacle.GetNetname() or None
            if target_net is not None and obstacle_net == target_net:
                continue
            distance = obstacle.GetEffectiveShape(copper_layer).Distance(position)
            distance_nm = floor(float(distance))
            if distance_nm < 0:
                raise ValueError(f"KiCad returned a negative pad distance for {endpoint}")
            candidate = (distance_nm, reference.casefold(), reference, obstacle_net)
            if nearest is None or candidate[:3] < nearest[:3]:
                nearest = candidate
        observations.append(
            {
                "endpoint": endpoint,
                "side": side,
                "target_net": target_net,
                "target_exposed": True,
                "obstacle": nearest[2] if nearest is not None else None,
                "obstacle_net": nearest[3] if nearest is not None else None,
                "distance_nm": nearest[0] if nearest is not None else None,
                "target_aperture_shape": aperture_shape,
                "target_aperture_diameter_nm": aperture_diameter_nm,
            }
        )
    return observations


def read_access_requests(path: Path | None) -> tuple[list[dict[str, str]], str | None]:
    if path is None:
        return [], None
    raw = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw, dict) or set(raw) != {"schema_version", "requests"}:
        raise ValueError("Native probe request file has an invalid object shape")
    if raw["schema_version"] != "1" or not isinstance(raw["requests"], list):
        raise ValueError("Native probe request file has an unsupported schema")
    requests: list[dict[str, str]] = []
    seen: set[tuple[str, str]] = set()
    for row in raw["requests"]:
        if not isinstance(row, dict) or set(row) != {"endpoint", "net", "side"}:
            raise ValueError("Native probe request has an invalid shape")
        endpoint, net, side = row["endpoint"], row["net"], row["side"]
        if not all(isinstance(item, str) and item.strip() for item in (endpoint, net, side)):
            raise ValueError("Native probe request values must be non-empty strings")
        if side not in {"front", "back"} or endpoint.count(".") != 1:
            raise ValueError("Native probe request has an invalid endpoint or side")
        key = (endpoint.casefold(), side)
        if key in seen:
            raise ValueError("Native probe requests contain a duplicate endpoint surface")
        seen.add(key)
        requests.append({"endpoint": endpoint, "net": net, "side": side})
    if not requests:
        raise ValueError("Native probe request file must contain at least one request")
    return requests, sha256(path)


def canonical_ring_nm(chain: Any) -> list[list[int]]:
    points: list[tuple[int, int]] = []
    for index in range(chain.PointCount()):
        point = chain.CPoint(index)
        candidate = (int(point.x), int(point.y))
        if not points or candidate != points[-1]:
            points.append(candidate)
    if len(points) > 1 and points[0] == points[-1]:
        points.pop()
    if len(set(points)) < 3:
        raise ValueError("Native filled-zone contour has fewer than three distinct points")

    def minimum_rotation(ring: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
        first = min(ring)
        return min(
            tuple(ring[index:] + ring[:index]) for index, point in enumerate(ring) if point == first
        )

    canonical = min(minimum_rotation(points), minimum_rotation(list(reversed(points))))
    return [[x, y] for x, y in canonical]


def filled_zone_islands(filled: Any) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    for island_index in range(filled.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(filled.CHole(island_index, hole_index))
            for hole_index in range(filled.HoleCount(island_index))
        )
        result.append(
            {
                "island_index": island_index,
                "outline_nm": canonical_ring_nm(filled.COutline(island_index)),
                "holes_nm": holes,
            }
        )
    return result


def rule_area_observation(zone: Any, board: Any) -> dict[str, Any] | None:
    """Return exact native outline, layer, and restriction evidence for one rule area."""
    if not bool(zone.GetIsRuleArea()):
        return None
    outline_set = zone.Outline()
    polygons: list[dict[str, Any]] = []
    for outline_index in range(outline_set.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(outline_set.CHole(outline_index, hole_index))
            for hole_index in range(outline_set.HoleCount(outline_index))
        )
        polygons.append(
            {
                "outline_nm": canonical_ring_nm(outline_set.COutline(outline_index)),
                "holes_nm": holes,
            }
        )
    if not polygons:
        raise ValueError("Native PCB rule area has no authored polygon outline")
    polygons.sort(
        key=lambda item: json.dumps(item, sort_keys=True, separators=(",", ":"))
    )
    layer_set = zone.GetLayerSet()
    copper_layers = board.GetEnabledLayers().CuStack()
    layers = [
        board.GetLayerName(layer)
        for layer in copper_layers
        if layer_set.Contains(layer)
    ]
    return {
        "uuid": zone.m_Uuid.AsString(),
        "name": zone.GetZoneName() or "",
        "layers": layers,
        "net": zone.GetNetname() or None,
        "polygons": polygons,
        "forbids_tracks": bool(zone.GetDoNotAllowTracks()),
        "forbids_vias": bool(zone.GetDoNotAllowVias()),
        "forbids_pads": bool(zone.GetDoNotAllowPads()),
        "forbids_zone_fills": bool(zone.GetDoNotAllowZoneFills()),
        "forbids_footprints": bool(zone.GetDoNotAllowFootprints()),
    }


def normalized_filled_zone_polygons(zone: Any, layer: Any) -> Any:
    """Copy fractured zone contours and restore explicit outline/hole topology."""
    filled = native_pcbnew.SHAPE_POLY_SET(zone.GetFilledPolysList(layer))
    if not hasattr(filled, "Unfracture"):
        raise ValueError("KiCad native polygon API cannot restore filled-zone holes")
    filled.Unfracture()
    return filled


def main(board_path: Path, output_path: Path, request_path: Path | None = None) -> None:
    board = native_pcbnew.LoadBoard(str(board_path))
    if board is None:
        raise ValueError("KiCad could not load the board")

    zones = board.Zones()
    zones_refilled = True
    if zones:
        zones_refilled = bool(native_pcbnew.ZONE_FILLER(board).Fill(zones))
    if not zones_refilled:
        raise ValueError("KiCad could not refill PCB zones in memory")
    if not board.BuildConnectivity():
        raise ValueError("KiCad could not build PCB connectivity")

    connectivity = board.GetConnectivity()
    zone_rows: dict[tuple[str, str], dict[str, Any]] = {}
    zone_objects: dict[tuple[str, str], Any] = {}
    filled_polygons: dict[tuple[str, str], Any] = {}
    rule_areas: list[dict[str, Any]] = []
    for zone in zones:
        if zone.GetIsRuleArea():
            observation = rule_area_observation(zone, board)
            if observation is None:
                raise ValueError("Native rule-area classification changed during extraction")
            rule_areas.append(observation)
            continue
        uuid = zone.m_Uuid.AsString()
        layer = board.GetLayerName(zone.GetLayer())
        identity = (uuid.casefold(), layer.casefold())
        filled = normalized_filled_zone_polygons(zone, zone.GetLayer())
        if identity in zone_rows:
            raise ValueError(f"Duplicate native PCB zone identity {uuid} on {layer}")
        zone_rows[identity] = {
            "uuid": uuid,
            "layer": layer,
            "name": zone.GetZoneName() or "",
            "net": zone.GetNetname() or None,
            "filled_island_count": filled.OutlineCount(),
            "filled_islands": filled_zone_islands(filled),
        }
        zone_objects[identity] = zone
        filled_polygons[identity] = filled

    pad_rows: dict[str, dict[str, Any]] = {}
    pad_geometry: list[tuple[str, bool, Any]] = []
    via_rows: dict[str, dict[str, Any]] = {}
    via_identity_by_native_uuid: dict[str, str] = {}
    via_objects: list[tuple[str, Any]] = []
    track_rows: list[dict[str, Any]] = []
    track_objects: list[tuple[dict[str, Any], Any]] = []
    track_identity_by_native_uuid: dict[str, str] = {}
    for track in board.GetTracks():
        if isinstance(track, native_pcbnew.PCB_VIA):
            via = via_observation(track, board)
            identity = via["id"]
            native_uuid = track.m_Uuid.AsString().casefold()
            if native_uuid in via_identity_by_native_uuid:
                raise ValueError(f"Duplicate native PCB via identity {native_uuid}")
            via_identity_by_native_uuid[native_uuid] = identity
            if identity in via_rows:
                via_rows[identity]["multiplicity"] += 1
            else:
                via_rows[identity] = {**via, "multiplicity": 1}
            via_objects.append((identity, track))
            continue
        if not all(hasattr(track, name) for name in ("GetStart", "GetEnd", "GetWidth", "GetLayer")):
            raise ValueError(f"Unsupported native copper track item {track.GetClass()}")
        item_class = track.GetClass()
        if item_class == "PCB_TRACK":
            geometry_kind = "segment"
        elif item_class == "PCB_ARC":
            geometry_kind = "arc"
        else:
            raise ValueError(f"Unsupported native copper track geometry {item_class}")
        start = track.GetStart()
        end = track.GetEnd()
        row = {
            "uuid": track.m_Uuid.AsString(),
            "net": track.GetNetname() or None,
            "layer": board.GetLayerName(track.GetLayer()),
            "width_nm": int(track.GetWidth()),
            "start_nm": [int(start.x), int(start.y)],
            "end_nm": [int(end.x), int(end.y)],
            "geometry_kind": geometry_kind,
        }
        native_uuid = track.m_Uuid.AsString().casefold()
        if native_uuid in track_identity_by_native_uuid:
            raise ValueError(f"Duplicate native PCB track identity {native_uuid}")
        track_identity_by_native_uuid[native_uuid] = row["uuid"]
        track_rows.append(row)
        track_objects.append((row, track))
    ties: list[dict[str, Any]] = []
    for footprint in sorted(board.GetFootprints(), key=lambda item: item.GetReference()):
        footprint_id = footprint.GetFPIDAsString()
        dnp = bool(footprint.IsDNP())
        for pad in footprint.Pads():
            reference = pad_reference(pad)
            if not reference:
                continue
            pad_geometry.append((reference, dnp, pad))
            connected: set[str] = {reference}
            connected_zones: set[tuple[str, str]] = set()
            connected_vias: set[str] = set()
            for item in connectivity.GetConnectedItems(pad, 0):
                if item.GetClass() == "PAD":
                    item_reference = pad_reference(item)
                    if item_reference:
                        connected.add(item_reference)
                elif item.GetClass() == "ZONE":
                    connected_zones.add(
                        (item.m_Uuid.AsString(), board.GetLayerName(item.GetLayer()))
                    )
                elif item.GetClass() == "PCB_VIA":
                    native_uuid = item.m_Uuid.AsString().casefold()
                    identity = via_identity_by_native_uuid.get(native_uuid)
                    if identity is None:
                        raise ValueError(
                            f"Connected pad {reference} refers to an unobserved via {native_uuid}"
                        )
                    connected_vias.add(identity)
            connected_islands: list[dict[str, Any]] = []
            for uuid, layer in sorted(
                connected_zones, key=lambda item: (item[0].casefold(), item[1].casefold())
            ):
                identity = (uuid.casefold(), layer.casefold())
                zone = zone_objects.get(identity)
                filled = filled_polygons.get(identity)
                if zone is None or filled is None:
                    raise ValueError(
                        f"Connected pad {reference} refers to an unobserved zone {uuid} on {layer}"
                    )
                pad_shape = pad.GetEffectiveShape(zone.GetLayer())
                island_indices: list[int] = []
                for island_index in range(filled.OutlineCount()):
                    island = native_pcbnew.SHAPE_POLY_SET(filled.COutline(island_index))
                    for hole_index in range(filled.HoleCount(island_index)):
                        island.AddHole(filled.CHole(island_index, hole_index), 0)
                    if island.Collide(pad_shape):
                        island_indices.append(island_index)
                if not island_indices:
                    raise ValueError(
                        f"Connected pad {reference} has no copper-shape intersection with "
                        f"filled island of zone {uuid} on {layer}"
                    )
                connected_islands.extend(
                    {"uuid": uuid, "layer": layer, "island_index": island_index}
                    for island_index in island_indices
                )
            row: dict[str, Any] = {
                "pad": reference,
                "net": pad.GetNetname() or None,
                "footprint": footprint_id,
                "dnp": dnp,
                "positions_nm": [[int(pad.GetPosition().x), int(pad.GetPosition().y)]],
                "connected_pads": sorted(connected, key=str.casefold),
                "connected_vias": sorted(connected_vias),
                "connected_zones": [
                    {"uuid": uuid, "layer": layer}
                    for uuid, layer in sorted(
                        connected_zones, key=lambda item: (item[0].casefold(), item[1].casefold())
                    )
                ],
                "connected_islands": sorted(
                    connected_islands,
                    key=lambda item: (
                        item["uuid"].casefold(),
                        item["layer"].casefold(),
                        item["island_index"],
                    ),
                ),
            }
            key = reference.casefold()
            existing = pad_rows.get(key)
            if existing is not None:
                if any(existing[name] != row[name] for name in ("net", "footprint", "dnp")):
                    raise ValueError(f"Stacked pad {reference} has conflicting native identities")
                existing["connected_pads"] = sorted(
                    set(existing["connected_pads"]) | set(row["connected_pads"]),
                    key=str.casefold,
                )
                existing["positions_nm"] = sorted(
                    {
                        (int(position[0]), int(position[1]))
                        for position in existing["positions_nm"] + row["positions_nm"]
                    }
                )
                existing["connected_vias"] = sorted(
                    set(existing["connected_vias"]) | set(row["connected_vias"])
                )
                existing_zones = {
                    (item["uuid"], item["layer"]) for item in existing["connected_zones"]
                }
                existing_zones.update(connected_zones)
                existing["connected_zones"] = [
                    {"uuid": uuid, "layer": layer}
                    for uuid, layer in sorted(
                        existing_zones,
                        key=lambda item: (item[0].casefold(), item[1].casefold()),
                    )
                ]
                existing_islands = {
                    (item["uuid"], item["layer"], item["island_index"])
                    for item in existing["connected_islands"]
                }
                existing_islands.update(
                    (item["uuid"], item["layer"], item["island_index"])
                    for item in connected_islands
                )
                existing["connected_islands"] = [
                    {"uuid": uuid, "layer": layer, "island_index": island_index}
                    for uuid, layer, island_index in sorted(
                        existing_islands,
                        key=lambda item: (
                            item[0].casefold(),
                            item[1].casefold(),
                            item[2],
                        ),
                    )
                ]
            else:
                pad_rows[key] = row

        if footprint.IsNetTie():
            groups: set[tuple[str, ...]] = set()
            for pad in footprint.Pads():
                if not pad_reference(pad):
                    continue
                members = footprint.GetNetTiePads(pad)
                if members:
                    group = tuple(
                        sorted(
                            {
                                reference
                                for member in members
                                if (reference := pad_reference(member))
                            },
                            key=str.casefold,
                        )
                    )
                    if len(group) > 1:
                        groups.add(group)
            ties.append(
                {
                    "reference": footprint.GetReference(),
                    "footprint": footprint_id,
                    "dnp": dnp,
                    "pad_groups": [list(group) for group in sorted(groups)],
                }
            )

    def endpoint_contacts(track: Any, point: Any) -> tuple[list[str], list[str], list[str]]:
        layer = track.GetLayer()
        track_net = track.GetNetname() or None
        pads: set[str] = set()
        for reference, _dnp, pad in pad_geometry:
            if pad.GetNetname() != track_net or not pad.GetLayerSet().Contains(layer):
                continue
            shape = pad.GetEffectiveShape(layer)
            if shape is not None and shape.Collide(point, 0):
                pads.add(reference)
        vias: set[str] = set()
        for identity, via in via_objects:
            if via.GetNetname() != track_net or not via.GetLayerSet().Contains(layer):
                continue
            shape = via.GetEffectiveShape(layer)
            if shape is not None and shape.Collide(point, 0):
                vias.add(identity)
        connected_tracks: set[str] = set()
        source_uuid = track.m_Uuid.AsString().casefold()
        for item in connectivity.GetConnectedTracks(track):
            if item.GetClass() not in {"PCB_TRACK", "PCB_ARC"}:
                continue
            identity = item.m_Uuid.AsString().casefold()
            if identity == source_uuid:
                continue
            if item.GetNetname() != track_net or item.GetLayer() != layer:
                continue
            shape = item.GetEffectiveShape(layer)
            if shape is None or not shape.Collide(point, 0):
                continue
            contact = track_identity_by_native_uuid.get(identity)
            if contact is None:
                raise ValueError(f"Track endpoint refers to an unobserved native track {identity}")
            connected_tracks.add(contact)
        return (
            sorted(pads, key=str.casefold),
            sorted(vias),
            sorted(connected_tracks, key=str.casefold),
        )

    for row, track in track_objects:
        start_pads, start_vias, start_tracks = endpoint_contacts(track, track.GetStart())
        end_pads, end_vias, end_tracks = endpoint_contacts(track, track.GetEnd())
        row.update(
            {
                "start_pads": start_pads,
                "end_pads": end_pads,
                "start_vias": start_vias,
                "end_vias": end_vias,
                "start_tracks": start_tracks,
                "end_tracks": end_tracks,
            }
        )

    for identity, zone in zone_rows.items():
        mapped_islands = {
            island["island_index"]
            for pad in pad_rows.values()
            for island in pad["connected_islands"]
            if (island["uuid"].casefold(), island["layer"].casefold()) == identity
        }
        zone["unanchored_pad_island_indexes"] = sorted(
            set(range(zone["filled_island_count"])) - mapped_islands
        )

    access_requests, access_requests_sha256 = read_access_requests(request_path)
    access_observations = access_probe_observations(access_requests, pad_geometry)

    output = {
        "schema_version": "11",
        "board_sha256": sha256(board_path),
        "kicad_version": native_pcbnew.GetBuildVersion(),
        "zones_refilled": zones_refilled,
        "pads": sorted(pad_rows.values(), key=lambda row: row["pad"].casefold()),
        "vias": sorted(via_rows.values(), key=lambda row: row["id"]),
        "net_ties": sorted(ties, key=lambda row: row["reference"].casefold()),
        "zones": sorted(
            zone_rows.values(),
            key=lambda row: (row["uuid"].casefold(), row["layer"].casefold()),
        ),
        "rule_areas": sorted(rule_areas, key=lambda row: row["uuid"].casefold()),
        "access_probe_observations": access_observations,
        "access_probe_requests_sha256": access_requests_sha256,
        "tracks": sorted(track_rows, key=lambda row: row["uuid"].casefold()),
        "copper_layers": [
            board.GetLayerName(layer) for layer in board.GetEnabledLayers().CuStack()
        ],
    }
    output_path.write_text(json.dumps(output, ensure_ascii=False, sort_keys=True, indent=2) + "\n")


if __name__ == "__main__":
    try:
        if len(sys.argv) not in {3, 4}:
            raise ValueError(
                "usage: native_pcb_probe.py BOARD.kicad_pcb OUTPUT.json [ACCESS_REQUESTS.json]"
            )
        main(
            Path(sys.argv[1]),
            Path(sys.argv[2]),
            Path(sys.argv[3]) if len(sys.argv) == 4 else None,
        )
    except Exception as exc:
        print(f"native PCB probe failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(2) from exc
