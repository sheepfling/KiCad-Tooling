"""Common prelude for the isolated KiCad 10 probe assembled for the pinned image."""

from __future__ import annotations

import hashlib
import json
import sys
from collections.abc import Callable, Iterable
from math import floor, isfinite, isqrt
from pathlib import Path
from typing import Protocol, cast, overload

import pcbnew as _pcbnew  # type: ignore[import-not-found]


class NativePoint(Protocol):
    x: int
    y: int


class NativeBox(Protocol):
    def GetLeft(self) -> int: ...

    def GetRight(self) -> int: ...

    def GetTop(self) -> int: ...

    def GetBottom(self) -> int: ...


class NativeUuid(Protocol):
    def AsString(self) -> str: ...


class NativeLineChain(Protocol):
    def PointCount(self) -> int: ...

    def CPoint(self, index: int) -> NativePoint: ...


class NativeLayerSet(Protocol):
    def Contains(self, layer: int) -> bool: ...


class NativeLayerStack(Protocol):
    def CuStack(self) -> Iterable[int]: ...


class NativePolygonSet(Protocol):
    def OutlineCount(self) -> int: ...

    def COutline(self, index: int) -> NativeLineChain: ...

    def HoleCount(self, index: int) -> int: ...

    def CHole(self, outline_index: int, hole_index: int) -> NativeLineChain: ...

    def Distance(self, point: NativePoint) -> int: ...

    def AddHole(self, hole: NativeLineChain, error: int) -> None: ...

    def Collide(self, shape: object) -> bool: ...


class NativeBoard(Protocol):
    def GetDesignSettings(self) -> NativeBoardDesignSettings: ...

    def GetEnabledLayers(self) -> NativeLayerStack: ...

    def GetLayerName(self, layer: int) -> str: ...

    def Zones(self) -> list[NativeZone]: ...

    def GetTracks(self) -> Iterable[NativeTrack]: ...

    def GetDrawings(self) -> Iterable[NativeDrawing]: ...

    def GetFootprints(self) -> Iterable[NativeFootprint]: ...

    def BuildConnectivity(self) -> bool: ...

    def GetConnectivity(self) -> NativeConnectivity: ...


class NativeBoardDesignSettings(Protocol):
    def GetBoardThickness(self) -> int: ...


class NativePad(Protocol):
    m_Uuid: NativeUuid

    def GetClass(self) -> str: ...

    def GetParentFootprint(self) -> NativeFootprint: ...

    def GetNumber(self) -> object: ...

    def GetLayerSet(self) -> NativeLayerSet: ...

    def GetShape(self, layer: int) -> int: ...

    def GetDrillSize(self) -> NativePoint: ...

    def GetDrillShape(self) -> int: ...

    def GetSecondaryDrillSize(self) -> NativePoint: ...

    def GetTertiaryDrillSize(self) -> NativePoint: ...

    def GetAttribute(self) -> int: ...

    def GetSize(self, layer: int) -> NativePoint: ...

    def GetSolderMaskExpansion(self, layer: int) -> int: ...

    def GetNetname(self) -> str: ...

    def GetPosition(self) -> NativePoint: ...

    def GetEffectiveShape(self, layer: int) -> NativeShape | None: ...

    def GetEffectiveHoleShape(self) -> NativeShape | None: ...

    def IsBackdrilledOrPostMachined(self, layer: int) -> bool: ...


class NativeShape(Protocol):
    def Distance(self, point: NativePoint) -> float: ...

    def IsNull(self) -> bool: ...

    def Collide(self, other: object, clearance: int) -> bool: ...

    def GetClearance(self, other: NativePolygonSet) -> int: ...


class NativeTrack(Protocol):
    m_Uuid: NativeUuid

    def GetClass(self) -> str: ...

    def GetNetname(self) -> str: ...

    def GetLayer(self) -> int: ...

    @overload
    def GetWidth(self) -> int: ...

    @overload
    def GetWidth(self, layer: int) -> int: ...

    def GetStart(self) -> NativePoint: ...

    def GetEnd(self) -> NativePoint: ...

    def GetLength(self) -> int: ...

    def GetMid(self) -> NativePoint: ...

    def GetEffectiveShape(self, layer: int) -> NativeShape | None: ...


class NativeVia(NativeTrack, Protocol):
    def TopLayer(self) -> int: ...

    def BottomLayer(self) -> int: ...

    def GetPosition(self) -> NativePoint: ...

    def IsMicroVia(self) -> bool: ...

    def IsBlindVia(self) -> bool: ...

    def IsBuriedVia(self) -> bool: ...

    def GetDrillValue(self) -> int: ...

    def GetLayerSet(self) -> NativeLayerSet: ...

    def GetEffectiveHoleShape(self) -> NativeShape | None: ...

    def IsTented(self, layer: int) -> bool: ...


class NativeConnectedItem(Protocol):
    m_Uuid: NativeUuid

    def GetClass(self) -> str: ...

    def GetLayer(self) -> int: ...


class NativeConnectivity(Protocol):
    def GetConnectedItems(
        self, pad: NativePad, clearance: int
    ) -> Iterable[NativeConnectedItem]: ...

    def GetConnectedTracks(self, track: NativeTrack) -> Iterable[NativeTrack]: ...


class NativeZone(Protocol):
    m_Uuid: NativeUuid

    def GetIsRuleArea(self) -> bool: ...

    def GetLayer(self) -> int: ...

    def GetFilledPolysList(self, layer: int) -> object: ...

    def Outline(self) -> NativePolygonSet: ...

    def GetLayerSet(self) -> NativeLayerSet: ...

    def GetZoneName(self) -> str: ...

    def GetNetname(self) -> str: ...

    def GetDoNotAllowTracks(self) -> bool: ...

    def GetDoNotAllowVias(self) -> bool: ...

    def GetDoNotAllowPads(self) -> bool: ...

    def GetDoNotAllowZoneFills(self) -> bool: ...

    def GetDoNotAllowFootprints(self) -> bool: ...


class NativeFootprint(Protocol):
    def GetReference(self) -> str: ...

    def GetFPIDAsString(self) -> str: ...

    def IsDNP(self) -> bool: ...

    def GetValue(self) -> str: ...

    def GetPosition(self) -> NativePoint: ...

    def GetOrientationDegrees(self) -> float: ...

    def GetLayer(self) -> int: ...

    def GetCourtyard(self, layer: int) -> NativePolygonSet: ...

    def GetBoundingBox(self, include_text: bool, include_hidden_text: bool) -> NativeBox: ...

    def Pads(self) -> Iterable[NativePad]: ...

    def IsNetTie(self) -> bool: ...

    def GetNetTiePads(self, pad: NativePad) -> Iterable[NativePad]: ...


class NativeZoneFiller(Protocol):
    def Fill(self, zones: list[NativeZone]) -> bool: ...


class NativePcbnew(Protocol):
    F_Cu: int
    B_Cu: int
    Edge_Cuts: int
    F_Mask: int
    B_Mask: int
    F_CrtYd: int
    B_CrtYd: int
    PAD_SHAPE_CIRCLE: int
    PAD_SHAPE_OVAL: int
    PAD_SHAPE_RECT: int
    PAD_SHAPE_ROUNDRECT: int
    PAD_DRILL_SHAPE_CIRCLE: int
    PAD_DRILL_SHAPE_OBLONG: int
    PAD_ATTRIB_NPTH: int
    PCB_VIA: type[NativeVia]
    SHAPE_POLY_SET: Callable[[object], NativePolygonSet]
    ZONE_FILLER: Callable[[NativeBoard], NativeZoneFiller]

    def GetBuildVersion(self) -> str: ...

    def LoadBoard(self, path: str) -> NativeBoard | None: ...


native_pcbnew = cast(NativePcbnew, _pcbnew)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pad_reference(pad: NativePad) -> str:
    footprint = pad.GetParentFootprint()
    number = str(pad.GetNumber()).strip()
    if not number:
        return ""
    return f"{footprint.GetReference()}.{number}"


def via_observation(via: NativeVia, board: NativeBoard) -> ViaObservation:
    """Return a geometry-derived stable identity for one KiCad via."""
    top_layer = via.TopLayer()
    bottom_layer = via.BottomLayer()
    start_layer = board.GetLayerName(top_layer)
    end_layer = board.GetLayerName(bottom_layer)
    position = via.GetPosition()
    if via.IsMicroVia():
        kind = "micro"
    elif via.IsBlindVia():
        kind = "blind"
    elif via.IsBuriedVia():
        kind = "buried"
    else:
        kind = "through"
    geometry: ViaGeometry = {
        "net": via.GetNetname() or None,
        "x_nm": int(position.x),
        "y_nm": int(position.y),
        "start_layer": start_layer,
        "end_layer": end_layer,
        "diameter_nm": int(via.GetWidth(top_layer)),
        "drill_nm": int(via.GetDrillValue()),
        "kind": kind,
    }
    canonical = json.dumps(geometry, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
    return {"id": hashlib.sha256(canonical.encode("ascii")).hexdigest(), **geometry}
