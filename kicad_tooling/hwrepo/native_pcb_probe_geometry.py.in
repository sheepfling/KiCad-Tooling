# Geometry observations: canonicalize filled zones, rule areas, and placements.

def canonical_ring_nm(chain: NativeLineChain) -> list[list[int]]:
    points: list[tuple[int, int]] = []
    for index in range(chain.PointCount()):
        point = chain.CPoint(index)
        candidate = (int(point.x), int(point.y))
        if not points or candidate != points[-1]:
            points.append(candidate)
    if len(points) > 1 and points[0] == points[-1]:
        points.pop()
    if len(set(points)) < 3:
        raise ValueError("Native filled-zone contour has fewer than three distinct points")

    def minimum_rotation(ring: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
        first = min(ring)
        return min(
            tuple(ring[index:] + ring[:index]) for index, point in enumerate(ring) if point == first
        )

    canonical = min(minimum_rotation(points), minimum_rotation(list(reversed(points))))
    return [[x, y] for x, y in canonical]


def filled_zone_islands(filled: NativePolygonSet) -> list[FilledZoneIslandObservation]:
    result: list[FilledZoneIslandObservation] = []
    for island_index in range(filled.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(filled.CHole(island_index, hole_index))
            for hole_index in range(filled.HoleCount(island_index))
        )
        result.append(
            {
                "island_index": island_index,
                "outline_nm": canonical_ring_nm(filled.COutline(island_index)),
                "holes_nm": holes,
            }
        )
    return result


def rule_area_observation(
    zone: NativeZone, board: NativeBoard
) -> RuleAreaObservation | None:
    """Return exact native outline, layer, and restriction evidence for one rule area."""
    if not bool(zone.GetIsRuleArea()):
        return None
    outline_set = zone.Outline()
    polygons: list[RuleAreaPolygonObservation] = []
    for outline_index in range(outline_set.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(outline_set.CHole(outline_index, hole_index))
            for hole_index in range(outline_set.HoleCount(outline_index))
        )
        polygons.append(
            {
                "outline_nm": canonical_ring_nm(outline_set.COutline(outline_index)),
                "holes_nm": holes,
            }
        )
    if not polygons:
        raise ValueError("Native PCB rule area has no authored polygon outline")
    polygons.sort(key=lambda item: json.dumps(item, sort_keys=True, separators=(",", ":")))
    layer_set = zone.GetLayerSet()
    copper_layers = board.GetEnabledLayers().CuStack()
    layers = [board.GetLayerName(layer) for layer in copper_layers if layer_set.Contains(layer)]
    return {
        "uuid": zone.m_Uuid.AsString(),
        "name": zone.GetZoneName() or "",
        "layers": layers,
        "net": zone.GetNetname() or None,
        "polygons": polygons,
        "forbids_tracks": bool(zone.GetDoNotAllowTracks()),
        "forbids_vias": bool(zone.GetDoNotAllowVias()),
        "forbids_pads": bool(zone.GetDoNotAllowPads()),
        "forbids_zone_fills": bool(zone.GetDoNotAllowZoneFills()),
        "forbids_footprints": bool(zone.GetDoNotAllowFootprints()),
    }


def footprint_placement_observation(
    footprint: NativeFootprint, board: NativeBoard
) -> FootprintPlacementObservation | None:
    """Return a canonical, source-bound transform for one referenced footprint."""
    reference = str(footprint.GetReference()).strip()
    if not reference:
        return None
    position = footprint.GetPosition()
    angle_degrees = float(footprint.GetOrientationDegrees())
    if not isfinite(angle_degrees):
        raise ValueError(f"Footprint {reference} has a non-finite placement angle")
    orientation_microdegrees = round((angle_degrees % 360.0) * 1_000_000) % 360_000_000
    side_name = board.GetLayerName(footprint.GetLayer())
    if side_name not in {"F.Cu", "B.Cu"}:
        raise ValueError(f"Footprint {reference} is on unsupported board side {side_name!r}")
    side = cast(Literal["F.Cu", "B.Cu"], side_name)
    return {
        "reference": reference,
        "footprint": footprint.GetFPIDAsString(),
        "dnp": bool(footprint.IsDNP()),
        "value": str(footprint.GetValue()),
        "position_nm": [int(position.x), int(position.y)],
        "orientation_microdegrees": orientation_microdegrees,
        "side": side,
    }


def normalized_filled_zone_polygons(zone: NativeZone, layer: int) -> NativePolygonSet:
    """Copy fractured zone contours and restore explicit outline/hole topology."""
    filled = cast(
        NativePolygonSet,
        native_pcbnew.SHAPE_POLY_SET(zone.GetFilledPolysList(layer)),
    )
    if not hasattr(filled, "Unfracture"):
        raise ValueError("KiCad native polygon API cannot restore filled-zone holes")
    filled.Unfracture()
    return filled


def filled_zone_island_shapes(filled: NativePolygonSet) -> tuple[tuple[int, NativePolygonSet], ...]:
    """Return independent native filled-island shapes with holes restored."""
    islands: list[tuple[int, NativePolygonSet]] = []
    for island_index in range(filled.OutlineCount()):
        island = native_pcbnew.SHAPE_POLY_SET(filled.COutline(island_index))
        for hole_index in range(filled.HoleCount(island_index)):
            island.AddHole(filled.CHole(island_index, hole_index), 0)
        islands.append((island_index, island))
    return tuple(islands)


def cached_zone_island_shapes(
    identity: tuple[str, str],
    filled_polygons: dict[tuple[str, str], NativePolygonSet],
    shape_cache: dict[tuple[str, str], tuple[tuple[int, NativePolygonSet], ...]],
) -> tuple[tuple[int, NativePolygonSet], ...]:
    """Build and retain one zone's filled-island copper shapes on first use."""
    shapes = shape_cache.get(identity)
    if shapes is not None:
        return shapes
    filled = filled_polygons.get(identity)
    if filled is None:
        raise ValueError(f"Native PCB zone {identity[0]} has no retained filled geometry")
    shapes = filled_zone_island_shapes(filled)
    shape_cache[identity] = shapes
    return shapes


def zone_island_indexes_connected_to_pad_component(
    connected_items: Iterable[NativeConnectedItem],
    zone: NativeZone,
    islands: tuple[tuple[int, NativePolygonSet], ...],
    item_touch_cache: dict[tuple[str, str, int], tuple[int, ...]],
) -> tuple[int, ...]:
    """Map copper islands touched by items in one native pad-connectivity component."""
    layer = zone.GetLayer()
    connected: set[int] = set()
    for item in connected_items:
        key = (item.m_Uuid.AsString().casefold(), zone.m_Uuid.AsString().casefold(), layer)
        item_islands = item_touch_cache.get(key)
        if item_islands is None:
            item_islands = zone_island_indexes_touched_by_item(item, zone, islands)
            item_touch_cache[key] = item_islands
        connected.update(item_islands)
    return tuple(sorted(connected))


def zone_island_indexes_touched_by_item(
    item: NativeConnectedItem,
    zone: NativeZone,
    islands: tuple[tuple[int, NativePolygonSet], ...],
) -> tuple[int, ...]:
    """Return exact filled islands touched by one connected native copper item."""
    layer = zone.GetLayer()
    item_class = item.GetClass()
    if item_class == "PAD":
        native_pad = cast(NativePad, item)
        if not native_pad.GetLayerSet().Contains(layer):
            return ()
        shape = native_pad.GetEffectiveShape(layer)
    elif item_class == "PCB_VIA":
        native_via = cast(NativeVia, item)
        if not native_via.GetLayerSet().Contains(layer):
            return ()
        shape = native_via.GetEffectiveShape(layer)
    elif item_class in {"PCB_TRACK", "PCB_ARC"}:
        native_track = cast(NativeTrack, item)
        if native_track.GetLayer() != layer:
            return ()
        shape = native_track.GetEffectiveShape(layer)
    else:
        return ()
    if shape is None:
        return ()
    return tuple(island_index for island_index, island in islands if island.Collide(shape))
