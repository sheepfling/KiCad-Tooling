# Geometry observations: canonicalize filled zones, rule areas, and placements.

def canonical_ring_nm(chain: Any) -> list[list[int]]:
    points: list[tuple[int, int]] = []
    for index in range(chain.PointCount()):
        point = chain.CPoint(index)
        candidate = (int(point.x), int(point.y))
        if not points or candidate != points[-1]:
            points.append(candidate)
    if len(points) > 1 and points[0] == points[-1]:
        points.pop()
    if len(set(points)) < 3:
        raise ValueError("Native filled-zone contour has fewer than three distinct points")

    def minimum_rotation(ring: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
        first = min(ring)
        return min(
            tuple(ring[index:] + ring[:index]) for index, point in enumerate(ring) if point == first
        )

    canonical = min(minimum_rotation(points), minimum_rotation(list(reversed(points))))
    return [[x, y] for x, y in canonical]


def filled_zone_islands(filled: Any) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    for island_index in range(filled.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(filled.CHole(island_index, hole_index))
            for hole_index in range(filled.HoleCount(island_index))
        )
        result.append(
            {
                "island_index": island_index,
                "outline_nm": canonical_ring_nm(filled.COutline(island_index)),
                "holes_nm": holes,
            }
        )
    return result


def rule_area_observation(zone: Any, board: Any) -> dict[str, Any] | None:
    """Return exact native outline, layer, and restriction evidence for one rule area."""
    if not bool(zone.GetIsRuleArea()):
        return None
    outline_set = zone.Outline()
    polygons: list[dict[str, Any]] = []
    for outline_index in range(outline_set.OutlineCount()):
        holes = sorted(
            canonical_ring_nm(outline_set.CHole(outline_index, hole_index))
            for hole_index in range(outline_set.HoleCount(outline_index))
        )
        polygons.append(
            {
                "outline_nm": canonical_ring_nm(outline_set.COutline(outline_index)),
                "holes_nm": holes,
            }
        )
    if not polygons:
        raise ValueError("Native PCB rule area has no authored polygon outline")
    polygons.sort(key=lambda item: json.dumps(item, sort_keys=True, separators=(",", ":")))
    layer_set = zone.GetLayerSet()
    copper_layers = board.GetEnabledLayers().CuStack()
    layers = [board.GetLayerName(layer) for layer in copper_layers if layer_set.Contains(layer)]
    return {
        "uuid": zone.m_Uuid.AsString(),
        "name": zone.GetZoneName() or "",
        "layers": layers,
        "net": zone.GetNetname() or None,
        "polygons": polygons,
        "forbids_tracks": bool(zone.GetDoNotAllowTracks()),
        "forbids_vias": bool(zone.GetDoNotAllowVias()),
        "forbids_pads": bool(zone.GetDoNotAllowPads()),
        "forbids_zone_fills": bool(zone.GetDoNotAllowZoneFills()),
        "forbids_footprints": bool(zone.GetDoNotAllowFootprints()),
    }


def footprint_placement_observation(footprint: Any, board: Any) -> dict[str, Any] | None:
    """Return a canonical, source-bound transform for one referenced footprint."""
    reference = str(footprint.GetReference()).strip()
    if not reference:
        return None
    position = footprint.GetPosition()
    angle_degrees = float(footprint.GetOrientationDegrees())
    if not isfinite(angle_degrees):
        raise ValueError(f"Footprint {reference} has a non-finite placement angle")
    orientation_microdegrees = round((angle_degrees % 360.0) * 1_000_000) % 360_000_000
    side = board.GetLayerName(footprint.GetLayer())
    if side not in {"F.Cu", "B.Cu"}:
        raise ValueError(f"Footprint {reference} is on unsupported board side {side!r}")
    return {
        "reference": reference,
        "footprint": footprint.GetFPIDAsString(),
        "dnp": bool(footprint.IsDNP()),
        "position_nm": [int(position.x), int(position.y)],
        "orientation_microdegrees": orientation_microdegrees,
        "side": side,
    }


def normalized_filled_zone_polygons(zone: Any, layer: Any) -> Any:
    """Copy fractured zone contours and restore explicit outline/hole topology."""
    filled = native_pcbnew.SHAPE_POLY_SET(zone.GetFilledPolysList(layer))
    if not hasattr(filled, "Unfracture"):
        raise ValueError("KiCad native polygon API cannot restore filled-zone holes")
    filled.Unfracture()
    return filled


def zone_island_indexes_touching_pad(pad: Any, zone: Any, filled: Any) -> tuple[int, ...]:
    """Return filled islands on this pad's copper layers that touch its copper shape."""
    layer = zone.GetLayer()
    if not pad.GetLayerSet().Contains(layer):
        return ()
    pad_shape = pad.GetEffectiveShape(layer)
    indexes: list[int] = []
    for island_index in range(filled.OutlineCount()):
        island = native_pcbnew.SHAPE_POLY_SET(filled.COutline(island_index))
        for hole_index in range(filled.HoleCount(island_index)):
            island.AddHole(filled.CHole(island_index, hole_index), 0)
        if island.Collide(pad_shape):
            indexes.append(island_index)
    return tuple(indexes)
