# Access probes: validate authored requests and measure source-defined surfaces.

class AccessProbeObservation(TypedDict):
    endpoint: str
    side: Literal["front", "back"]
    target_net: str | None
    target_exposed: bool
    obstacle: str | None
    obstacle_net: str | None
    distance_nm: int | None
    target_aperture_shape: Literal[
        "circle", "oval", "rectangle", "roundrect", "unsupported"
    ] | None
    target_aperture_diameter_nm: int | None
    courtyard_obstacle: str | None
    courtyard_distance_nm: int | None
    unmeasured_courtyard_footprint: str | None
    unmeasured_courtyard_distance_nm: int | None
    via_obstacle_id: str | None
    via_obstacle_net: str | None
    via_obstacle_distance_nm: int | None
    via_obstacle_tented: bool | None
    track_obstacle_uuid: str | None
    track_obstacle_net: str | None
    track_obstacle_distance_nm: int | None
    track_obstacle_geometry: Literal["segment", "arc"] | None
    zone_obstacle_uuid: str | None
    zone_obstacle_layer: str | None
    zone_obstacle_net: str | None
    zone_obstacle_island_index: int | None
    zone_obstacle_distance_nm: int | None


def access_probe_observations(
    requests: list[AccessProbeRequest],
    pad_geometry: list[tuple[str, bool, NativePad]],
    footprint_geometry: list[tuple[str, bool, int, NativeFootprint]],
    via_geometry: list[tuple[str, str | None, NativeVia]],
    track_geometry: list[tuple[str, str | None, NativeTrack]],
    zone_geometry: list[tuple[str, str | None, int, int, NativePolygonSet]],
) -> list[AccessProbeObservation]:
    """Measure foreign pads/tracks, untented vias, and courtyards from each pad center."""
    observations: list[AccessProbeObservation] = []
    layer_ids = {
        "front": (native_pcbnew.F_Cu, native_pcbnew.F_Mask),
        "back": (native_pcbnew.B_Cu, native_pcbnew.B_Mask),
    }
    courtyard_layers = {"front": native_pcbnew.F_CrtYd, "back": native_pcbnew.B_CrtYd}
    footprint_sides = {native_pcbnew.F_Cu: "front", native_pcbnew.B_Cu: "back"}
    copper_layer_names = {native_pcbnew.F_Cu: "F.Cu", native_pcbnew.B_Cu: "B.Cu"}

    def exposed(pad: NativePad, side: Literal["front", "back"]) -> bool:
        copper_layer, mask_layer = layer_ids[side]
        layers = pad.GetLayerSet()
        return bool(layers.Contains(copper_layer) and layers.Contains(mask_layer))

    def aperture_geometry(
        pad: NativePad, mask_layer: int
    ) -> tuple[
        Literal["circle", "oval", "rectangle", "roundrect", "unsupported"], int | None
    ]:
        """Measure centered circular-tip fit for symmetric, undrilled mask apertures."""
        shapes: dict[int, Literal["circle", "oval", "rectangle", "roundrect"]] = {
            native_pcbnew.PAD_SHAPE_CIRCLE: "circle",
            native_pcbnew.PAD_SHAPE_OVAL: "oval",
            native_pcbnew.PAD_SHAPE_RECT: "rectangle",
            native_pcbnew.PAD_SHAPE_ROUNDRECT: "roundrect",
        }
        shape = shapes.get(pad.GetShape(mask_layer))
        if shape is None:
            return "unsupported", None
        drill = pad.GetDrillSize()
        if int(drill.x) > 0 or int(drill.y) > 0:
            return "unsupported", None
        copper_size = pad.GetSize(mask_layer)
        width_nm = int(copper_size.x)
        height_nm = int(copper_size.y)
        if width_nm <= 0 or height_nm <= 0:
            return "unsupported", None
        if shape == "circle" and width_nm != height_nm:
            return "unsupported", None
        mask_expansion_nm = int(pad.GetSolderMaskExpansion(mask_layer))
        diameter_nm = min(width_nm, height_nm) + 2 * mask_expansion_nm
        if diameter_nm <= 0:
            return "unsupported", None
        return shape, diameter_nm

    for request in requests:
        endpoint = request["endpoint"]
        side = request["side"]
        copper_layer, _mask_layer = layer_ids[side]
        endpoint_pads = [
            (dnp, pad)
            for reference, dnp, pad in pad_geometry
            if reference.casefold() == endpoint.casefold()
        ]
        if not endpoint_pads:
            raise ValueError(f"Requested probe endpoint {endpoint} is absent from the PCB")
        target_nets = {pad.GetNetname() or None for _dnp, pad in endpoint_pads}
        if len(target_nets) != 1:
            raise ValueError(f"Requested probe endpoint {endpoint} has conflicting pad nets")
        target_net = next(iter(target_nets))
        targets = [pad for dnp, pad in endpoint_pads if not dnp and exposed(pad, side)]
        if len(targets) > 1:
            raise ValueError(
                f"Requested probe endpoint {endpoint} has multiple exposed {side}-side pads"
            )
        if not targets:
            observations.append(
                {
                    "endpoint": endpoint,
                    "side": side,
                    "target_net": target_net,
                    "target_exposed": False,
                    "obstacle": None,
                    "obstacle_net": None,
                    "distance_nm": None,
                    "target_aperture_shape": None,
                    "target_aperture_diameter_nm": None,
                    "courtyard_obstacle": None,
                    "courtyard_distance_nm": None,
                    "unmeasured_courtyard_footprint": None,
                    "unmeasured_courtyard_distance_nm": None,
                    "via_obstacle_id": None,
                    "via_obstacle_net": None,
                    "via_obstacle_distance_nm": None,
                    "via_obstacle_tented": None,
                    "track_obstacle_uuid": None,
                    "track_obstacle_net": None,
                    "track_obstacle_distance_nm": None,
                    "track_obstacle_geometry": None,
                    "zone_obstacle_uuid": None,
                    "zone_obstacle_layer": None,
                    "zone_obstacle_net": None,
                    "zone_obstacle_island_index": None,
                    "zone_obstacle_distance_nm": None,
                }
            )
            continue
        target = targets[0]
        aperture_shape, aperture_diameter_nm = aperture_geometry(target, layer_ids[side][1])
        nearest: tuple[int, str, str, str | None] | None = None
        position = target.GetPosition()
        for reference, dnp, obstacle in pad_geometry:
            if reference.casefold() == endpoint.casefold() or dnp or not exposed(obstacle, side):
                continue
            obstacle_net = obstacle.GetNetname() or None
            if target_net is not None and obstacle_net == target_net:
                continue
            shape = obstacle.GetEffectiveShape(copper_layer)
            if shape is None:
                raise ValueError(f"KiCad returned no effective shape for obstacle {reference}")
            distance = shape.Distance(position)
            distance_nm = floor(float(distance))
            if distance_nm < 0:
                raise ValueError(f"KiCad returned a negative pad distance for {endpoint}")
            candidate = (distance_nm, reference.casefold(), reference, obstacle_net)
            if nearest is None or candidate[:3] < nearest[:3]:
                nearest = candidate
        target_reference = endpoint.rsplit(".", 1)[0]
        nearest_courtyard: tuple[int, str, str] | None = None
        nearest_unmeasured: tuple[int, str, str] | None = None
        for reference, dnp, footprint_layer, footprint in footprint_geometry:
            if (
                reference.casefold() == target_reference.casefold()
                or dnp
                or footprint_sides.get(footprint_layer) != side
            ):
                continue
            courtyard = footprint.GetCourtyard(courtyard_layers[side])
            if courtyard.OutlineCount() > 0:
                distance_nm = int(courtyard.Distance(position))
                if distance_nm < 0:
                    raise ValueError(
                        f"KiCad returned a negative courtyard distance for {endpoint}"
                    )
                candidate = (distance_nm, reference.casefold(), reference)
                if nearest_courtyard is None or candidate < nearest_courtyard:
                    nearest_courtyard = candidate
                continue
            box = footprint.GetBoundingBox(False, False)
            dx = max(box.GetLeft() - int(position.x), 0, int(position.x) - box.GetRight())
            dy = max(box.GetTop() - int(position.y), 0, int(position.y) - box.GetBottom())
            distance_nm = isqrt(dx * dx + dy * dy)
            candidate = (distance_nm, reference.casefold(), reference)
            if nearest_unmeasured is None or candidate < nearest_unmeasured:
                nearest_unmeasured = candidate
        nearest_via: tuple[int, str, str, str | None] | None = None
        for identity, via_net, via in via_geometry:
            if not via.GetLayerSet().Contains(copper_layer) or via.IsTented(copper_layer):
                continue
            if target_net is not None and via_net == target_net:
                continue
            shape = via.GetEffectiveShape(copper_layer)
            if shape is None:
                raise ValueError(f"KiCad returned no effective via shape for {endpoint}")
            distance_nm = floor(float(shape.Distance(position)))
            if distance_nm < 0:
                raise ValueError(f"KiCad returned a negative via distance for {endpoint}")
            candidate = (distance_nm, identity.casefold(), identity, via_net)
            if nearest_via is None or candidate[:3] < nearest_via[:3]:
                nearest_via = candidate
        nearest_track: tuple[int, str, str, str | None, Literal["segment", "arc"]] | None = None
        for identity, track_net, track in track_geometry:
            item_class = track.GetClass()
            if item_class not in {"PCB_TRACK", "PCB_ARC"} or track.GetLayer() != copper_layer:
                continue
            if target_net is not None and track_net == target_net:
                continue
            shape = track.GetEffectiveShape(copper_layer)
            if shape is None:
                raise ValueError(f"KiCad returned no effective track shape for {endpoint}")
            distance_nm = floor(float(shape.Distance(position)))
            if distance_nm < 0:
                raise ValueError(f"KiCad returned a negative track distance for {endpoint}")
            geometry_kind: Literal["segment", "arc"] = (
                "segment" if item_class == "PCB_TRACK" else "arc"
            )
            candidate = (distance_nm, identity.casefold(), identity, track_net, geometry_kind)
            if nearest_track is None or candidate[:3] < nearest_track[:3]:
                nearest_track = candidate
        nearest_zone: tuple[int, str, str, str, str | None, int] | None = None
        for identity, zone_net, zone_layer, island_index, island in zone_geometry:
            if zone_layer != copper_layer or (target_net is not None and zone_net == target_net):
                continue
            distance_nm = floor(float(island.Distance(position)))
            if distance_nm < 0:
                raise ValueError(f"KiCad returned a negative zone distance for {endpoint}")
            layer_name = copper_layer_names[zone_layer]
            candidate = (
                distance_nm,
                identity.casefold(),
                layer_name.casefold(),
                identity,
                zone_net,
                island_index,
            )
            if nearest_zone is None or candidate[:3] < nearest_zone[:3]:
                nearest_zone = candidate
        observations.append(
            {
                "endpoint": endpoint,
                "side": side,
                "target_net": target_net,
                "target_exposed": True,
                "obstacle": nearest[2] if nearest is not None else None,
                "obstacle_net": nearest[3] if nearest is not None else None,
                "distance_nm": nearest[0] if nearest is not None else None,
                "target_aperture_shape": aperture_shape,
                "target_aperture_diameter_nm": aperture_diameter_nm,
                "courtyard_obstacle": (
                    nearest_courtyard[2] if nearest_courtyard is not None else None
                ),
                "courtyard_distance_nm": (
                    nearest_courtyard[0] if nearest_courtyard is not None else None
                ),
                "unmeasured_courtyard_footprint": (
                    nearest_unmeasured[2] if nearest_unmeasured is not None else None
                ),
                "unmeasured_courtyard_distance_nm": (
                    nearest_unmeasured[0] if nearest_unmeasured is not None else None
                ),
                "via_obstacle_id": nearest_via[2] if nearest_via is not None else None,
                "via_obstacle_net": nearest_via[3] if nearest_via is not None else None,
                "via_obstacle_distance_nm": nearest_via[0] if nearest_via is not None else None,
                "via_obstacle_tented": False if nearest_via is not None else None,
                "track_obstacle_uuid": nearest_track[2] if nearest_track is not None else None,
                "track_obstacle_net": nearest_track[3] if nearest_track is not None else None,
                "track_obstacle_distance_nm": nearest_track[0] if nearest_track is not None else None,
                "track_obstacle_geometry": nearest_track[4] if nearest_track is not None else None,
                "zone_obstacle_uuid": nearest_zone[3] if nearest_zone is not None else None,
                "zone_obstacle_layer": (
                    copper_layer_names[copper_layer] if nearest_zone is not None else None
                ),
                "zone_obstacle_net": nearest_zone[4] if nearest_zone is not None else None,
                "zone_obstacle_island_index": nearest_zone[5] if nearest_zone is not None else None,
                "zone_obstacle_distance_nm": nearest_zone[0] if nearest_zone is not None else None,
            }
        )
    return observations


def read_access_requests(path: Path | None) -> tuple[list[AccessProbeRequest], str | None]:
    if path is None:
        return [], None
    raw_value: object = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(raw_value, dict) or set(raw_value) != {"schema_version", "requests"}:
        raise ValueError("Native probe request file has an invalid object shape")
    raw = cast(RawAccessRequestEnvelope, raw_value)
    if raw["schema_version"] != "1" or not isinstance(raw["requests"], list):
        raise ValueError("Native probe request file has an unsupported schema")
    raw_requests = cast(list[object], raw["requests"])
    requests: list[AccessProbeRequest] = []
    seen: set[tuple[str, str]] = set()
    for row_value in raw_requests:
        if not isinstance(row_value, dict) or set(row_value) != {"endpoint", "net", "side"}:
            raise ValueError("Native probe request has an invalid shape")
        row = cast(RawAccessProbeRequest, row_value)
        endpoint_value, net_value, side_value = row["endpoint"], row["net"], row["side"]
        if not isinstance(endpoint_value, str) or not endpoint_value.strip():
            raise ValueError("Native probe request values must be non-empty strings")
        if not isinstance(net_value, str) or not net_value.strip():
            raise ValueError("Native probe request values must be non-empty strings")
        if not isinstance(side_value, str) or not side_value.strip():
            raise ValueError("Native probe request values must be non-empty strings")
        if side_value not in {"front", "back"} or endpoint_value.count(".") != 1:
            raise ValueError("Native probe request has an invalid endpoint or side")
        side = cast(Literal["front", "back"], side_value)
        key = (endpoint_value.casefold(), side)
        if key in seen:
            raise ValueError("Native probe requests contain a duplicate endpoint surface")
        seen.add(key)
        requests.append({"endpoint": endpoint_value, "net": net_value, "side": side})
    if not requests:
        raise ValueError("Native probe request file must contain at least one request")
    return requests, sha256(path)
