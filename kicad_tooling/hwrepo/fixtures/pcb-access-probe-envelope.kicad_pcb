(kicad_pcb
  (version 20250114)
  (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "TARGET_ACCESS")
  (net 2 "FOREIGN_DNP")
  (net 3 "FOREIGN_FRONT")
  (net 4 "FOREIGN_BACK")
  (net 5 "TARGET_NO_NET_NEIGHBOR")
  (net 6 "TARGET_FRONT_ONLY")
  (net 7 "FOREIGN_FRONT_ONLY")
  (net 8 "TARGET_APERTURE_SMALL")
  (net 9 "TARGET_APERTURE_BOUNDARY")
  (net 10 "TARGET_APERTURE_RECT")
  (net 11 "TARGET_APERTURE_DRILLED")
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 5 5)
    (property "Reference" "J1")
    (property "Value" "AccessTarget")
    (pad "1" smd circle (at 0 0) (size 1.2 1.2)
      (layers "*.Cu" "*.Mask") (net 1 "TARGET_ACCESS")))
  (footprint "Synthetic:AccessNeighbor" (layer "F.Cu") (at 5.15 5)
    (property "Reference" "J2")
    (property "Value" "SameNetNeighbor")
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "F.Cu" "F.Mask") (net 1 "TARGET_ACCESS")))
  (footprint "Synthetic:AccessNeighbor" (layer "F.Cu") (at 5.05 5)
    (property "Reference" "J3")
    (property "Value" "DnpNeighbor")
    (attr smd dnp)
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "F.Cu" "F.Mask") (net 2 "FOREIGN_DNP")))
  (footprint "Synthetic:AccessNeighbor" (layer "F.Cu") (at 5.5 5)
    (property "Reference" "J4")
    (property "Value" "FrontObstacle")
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "F.Cu" "F.Mask") (net 3 "FOREIGN_FRONT")))
  (footprint "Synthetic:AccessNeighbor" (layer "B.Cu") (at 5.9 5)
    (property "Reference" "J5")
    (property "Value" "BackObstacle")
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "B.Cu" "B.Mask") (net 4 "FOREIGN_BACK")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 20 5)
    (property "Reference" "J7")
    (property "Value" "NoNetNeighborTarget")
    (pad "1" smd circle (at 0 0) (size 0.8 0.8)
      (layers "F.Cu" "F.Mask") (net 5 "TARGET_NO_NET_NEIGHBOR")))
  (footprint "Synthetic:AccessNeighbor" (layer "F.Cu") (at 20.5 5)
    (property "Reference" "J8")
    (property "Value" "UnconnectedObstacle")
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "F.Cu" "F.Mask")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 35 5)
    (property "Reference" "J9")
    (property "Value" "FrontOnlyTarget")
    (pad "1" smd circle (at 0 0) (size 0.3 0.3)
      (layers "F.Cu" "F.Mask") (net 6 "TARGET_FRONT_ONLY")))
  (footprint "Synthetic:AccessNeighbor" (layer "F.Cu") (at 35.5 5)
    (property "Reference" "J10")
    (property "Value" "FrontOnlyObstacle")
    (pad "1" smd rect (at 0 0) (size 0.2 0.2)
      (layers "F.Cu" "F.Mask") (net 7 "FOREIGN_FRONT_ONLY")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 50 5)
    (property "Reference" "J11")
    (property "Value" "UndersizeApertureFault")
    (pad "1" smd circle (at 0 0) (size 0.4 0.4)
      (layers "F.Cu" "F.Mask") (net 8 "TARGET_APERTURE_SMALL")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 60 5)
    (property "Reference" "J12")
    (property "Value" "ExactApertureBoundaryControl")
    (pad "1" smd circle (at 0 0) (size 1.0 1.0)
      (layers "F.Cu" "F.Mask") (solder_mask_margin -0.1)
      (net 9 "TARGET_APERTURE_BOUNDARY")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 70 5)
    (property "Reference" "J13")
    (property "Value" "RectangularApertureUnsupported")
    (pad "1" smd rect (at 0 0) (size 1.0 1.0)
      (layers "F.Cu" "F.Mask") (net 10 "TARGET_APERTURE_RECT")))
  (footprint "Synthetic:AccessTarget" (layer "F.Cu") (at 80 5)
    (property "Reference" "J14")
    (property "Value" "DrilledApertureUnsupported")
    (pad "1" thru_hole circle (at 0 0) (size 1.0 1.0) (drill 0.4)
      (layers "*.Cu" "*.Mask") (net 11 "TARGET_APERTURE_DRILLED")))
)
