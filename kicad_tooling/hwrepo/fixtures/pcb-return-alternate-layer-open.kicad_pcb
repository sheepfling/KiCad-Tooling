(kicad_pcb
  (version 20250114)
  (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0))
  (net 0 "")
  (net 1 "RETURN")
  (footprint "Synthetic:TestPad" (layer "F.Cu") (at 5 5)
    (property "Reference" "J1")
    (property "Value" "TestPad")
    (pad "1" smd circle (at 0 0) (size 1 1)
      (layers "F.Cu" "F.Mask") (net 1 "RETURN")))
  (footprint "Synthetic:TestPad" (layer "B.Cu") (at 15 5)
    (property "Reference" "J2")
    (property "Value" "TestPad")
    (pad "1" smd circle (at 0 0) (size 1 1)
      (layers "B.Cu" "B.Mask") (net 1 "RETURN")))
  (segment (start 5 5) (end 10 5) (width 0.3) (layer "F.Cu") (net 1))
  (via (at 10 5) (size 0.8) (drill 0.3)
    (layers "F.Cu" "B.Cu") (remove_unused_layers no) (net 1))
)
